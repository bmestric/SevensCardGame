<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hr.bmestric.sevens.ui.controller.RmiConnectController"
      spacing="15"
      alignment="CENTER"
      prefHeight="300.0"
      prefWidth="350.0">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="titleLabel" text="Join RMI Game Server"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label fx:id="subtitleLabel"
           style="-fx-font-size: 11px; -fx-text-fill: gray;"/>

    <Label/>

    <Label text="Enter your name:"/>

    <TextField fx:id="playerNameField"
               prefWidth="250"/>

    <Label/>

    <Button fx:id="connectButton"
            text="Connect to Server"
            prefWidth="250"
            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px;"
            onAction="#onConnect"
            defaultButton="true"/>

</VBox>

